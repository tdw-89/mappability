/*
 * mappability
 *
 * Empirical paired-end mappability of target loci with UniMap.jl, sharded so
 * the bowtie2 step -- nearly all of the compute -- runs as many independent
 * tasks. See main.nf for the shape of the workflow and README.md for usage.
 *
 * Pick an environment with -profile local, docker, apptainer, unity, aws or
 * seqera; add `test` for the bundled mini-genome.
 */

manifest {
    name            = 'mappability'
    author          = 'Tom Wolfe'
    description     = 'Sharded UniMap.jl simulation of empirical paired-end mappability'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.10.0'
    version         = '0.1.0'
}

params {
    // ---- input / output ----------------------------------------------------
    fasta          = null   // reference FASTA (uncompressed); a .fai beside it is reused
    gff            = null   // GFF3 or GTF annotation, optionally .gz
    bowtie2_index  = null   // bowtie2 index prefix built from --fasta, e.g. ref/bowtie2/GRCz12tu;
                            // null builds one (BOWTIE2_BUILD) -- small genomes only
    outdir         = 'results'

    // ---- which loci --------------------------------------------------------
    // By default every GFF3 gene of this biotype (comma-separate several). GFF3
    // only; with a GTF, give --genes. See bin/select_genes.sh for how genes are
    // recognised across annotation sources.
    gene_biotype      = 'protein_coding'
    // The attribute holding the biotype. 'auto' takes gene_biotype (NCBI),
    // biotype (Ensembl) or gene_type (GENCODE), whichever the genes carry; with
    // none of them, protein-coding genes are those with a CDS.
    biotype_attribute = 'auto'
    // Or an explicit list of IDs, one per line (anything `unimap loci -g`
    // accepts). Overrides gene_biotype.
    genes          = null
    upstream       = 1500
    downstream     = 1500

    // ---- simulation grid (unimap simulate) ---------------------------------
    // Required: match them to the libraries the mappability is for, e.g.
    // --read_lengths 60,150 --fragment_lengths 50,75,100,150,200,300,400,500.
    // Every (L, F) pair is simulated; F < L is allowed (it models adapter
    // trimming). bowtie2 -X is set to the largest F.
    read_lengths     = null
    fragment_lengths = null
    step             = 10
    orientation      = 'plus'

    // ---- sharding ----------------------------------------------------------
    // Simulation regions are packed into batches balanced by read-pair count;
    // each batch is one ALIGN_BATCH task per read length. The number of
    // batches follows the data: enough that no batch holds more than
    // pairs_per_batch pairs for any one read length (35M is ~1 h of bowtie2 on
    // 16 cores), capped at 999 and at the number of regions. n_batches, if
    // set, fixes the count instead.
    pairs_per_batch = 35000000
    n_batches       = null

    // ---- alignment ---------------------------------------------------------
    // Extra bowtie2 arguments. -X is always set to the largest fragment length,
    // and the arguments that would break scoring (--no-unal, -X/--maxins, -p,
    // ...) are refused at launch.
    bowtie2_args   = ''

    // ---- scoring (unimap score) --------------------------------------------
    cutoffs        = '0,2,5,10,20,30'
    frag_mapq      = 'min'
    tolerance      = 0

    // ---- output ------------------------------------------------------------
    // mappability.zarr is ~450k chunk files at genome scale. Tarred (no
    // recompression: the chunks are already zstd) it is one object to stage
    // and publish instead of hundreds of thousands of PutObject calls.
    tar_zarr       = true
    // The shard BAMs are ~110 GB at genome scale and only needed to re-score
    // (`unimap score` reads them as shards). Off by default.
    publish_bams   = false
    publish_mode   = 'copy'

    // ---- software ----------------------------------------------------------
    // Julia threads for loci/simulate/score; null = the task's cpus. Set 1 only
    // to run the amd64 image under emulation (Apple Silicon), where
    // multithreaded Julia segfaults.
    julia_threads     = null
    // UniMap.jl project directory. Inside container_unimap this defaults to
    // the image's copy ($UNIMAP_PROJECT); without containers (-profile local)
    // it must point at a checkout with an instantiated environment.
    unimap_project    = null
    container_unimap  = 'ghcr.io/tdw-89/unimap:0.2.0'
    // nf-core's bowtie2/align image: bowtie2 2.5.2, samtools 1.18, pigz 2.6.
    container_bowtie2 = 'quay.io/biocontainers/mulled-v2-ac74a7f02cebcfcc07d8e8d1d750af9c83b4d45a:f70b31a2db15c023d641c32f433fb02cd04df5a6-0'

    // ---- misc --------------------------------------------------------------
    max_retries    = 3
    help           = false
}

includeConfig 'conf/base.config'

profiles {
    local     { includeConfig 'conf/local.config'  }
    test      { includeConfig 'conf/test.config'   }
    unity     { includeConfig 'conf/unity.config'  }
    aws       { includeConfig 'conf/aws.config'    }
    seqera    { includeConfig 'conf/seqera.config' }

    docker    { docker.enabled    = true; docker.runOptions = '-u $(id -u):$(id -g)' }
    apptainer { apptainer.enabled = true; apptainer.autoMounts = true }
}

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html"   }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt"     }
dag      { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/dag.html"      }

workflow.onComplete = {
    if (params.help) { return }
    if (!workflow.success) {
        println("Failed after ${workflow.duration}")
        return
    }
    println("Done in ${workflow.duration}. Scores: ${params.outdir}/scores")
}
