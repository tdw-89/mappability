/*
 * Seqera Platform, on an AWS Batch compute environment (Batch Forge).
 *
 *   Launch form -> Config profiles: seqera
 *
 * Deliberately NOT the `aws` profile. Seqera injects everything about WHERE the
 * run happens from the compute environment -- executor, queue, region, work
 * directory, Wave and Fusion -- and `aws` sets executor, queue, region, docker
 * and the AWS CLI path itself. Under Seqera those would at best repeat the
 * compute environment and at worst disagree with it (a hand-typed queue name,
 * aws.batch.cliPath on a Fusion instance that has no CLI).
 *
 * So this profile carries only WHAT the pipeline needs: cpus, memory, time. It
 * sets no executor, queue, region, docker, wave, fusion or scratch settings and
 * should stay that way. Retries come from conf/base.config's errorStrategy,
 * which treats Spot reclaims and OOM kills as retryable and doubles memory.
 *
 * Compute environment, recommended: Fusion + Wave enabled, Fusion snapshots
 * off, Spot, and instance families with local NVMe (c6id, m6id, r6id). With
 * Fusion, tasks read S3 inputs as a stream and only their own writes land on
 * local disk:
 *   SIMULATE_AND_BATCH  ~70 GB  of FASTQ, packed and deleted as it goes
 *   CAT_AND_SCORE       ~125 GB: the per-L BAMs (~110 GB) + Zarr store + tar
 * so CAT_AND_SCORE needs an instance with >= ~200 GB NVMe -- an m6id.xlarge
 * (237 GB) or larger, which the 4 cpu / 15 GB request already lands on in an
 * m6id-only environment. Without Fusion, see conf/aws.config for the larger
 * EBS sizing.
 *
 * Memory is sized to ECS-available RAM, ~4-6% under nominal: a round 16 GB
 * does not fit a 16 GiB instance and silently escalates to the next size.
 * Each withName block restates cpus, memory and time, because a block in a
 * profile replaces the one in conf/base.config rather than merging with it.
 */

process {
    withName: SAMTOOLS_FAIDX {
        cpus   = 1
        memory = { 1.5.GB * task.attempt }
        time   = { 1.h    * task.attempt }
    }

    withName: BOWTIE2_BUILD {
        cpus   = 16
        memory = { 28.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    withName: BUILD_LOCI {
        cpus   = 2
        memory = { 3.5.GB * task.attempt }
        time   = { 1.h    * task.attempt }
    }

    withName: SIMULATE_AND_BATCH {
        cpus   = 32
        memory = { 60.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    withName: ALIGN_BATCH {
        cpus   = 16
        memory = { 28.GB * task.attempt }
        time   = { 3.h   * task.attempt }
    }

    withName: CAT_AND_SCORE {
        cpus   = 4
        memory = { 15.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
}
