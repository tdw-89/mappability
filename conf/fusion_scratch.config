/*
 * Local scratch for the two tasks that write throwaway files. Included by
 * conf/seqera.config; test/run_tests.sh --e2e runs the fixture with it, so the
 * unstaging it relies on is checked against the monolithic result.
 *
 * Under Fusion, Nextflow runs a task inside its S3-backed work directory
 * (`scratch` defaults to false there), so every file a task writes becomes an
 * S3 object. Two tasks write many files they then throw away:
 *
 *   SIMULATE_AND_BATCH  49,024 per-region FASTQs (~65 GB) under sim/fastq,
 *                       concatenated into batches and deleted
 *   SCORE               mappability.zarr (~450k chunk files), tarred and deleted
 *
 * With scratch = true the task runs in `mktemp -d` under $TMPDIR (else /tmp)
 * and only the declared outputs go to the work directory. In a Seqera compute
 * environment with fast instance storage, the container's /tmp is the NVMe that
 * Batch Forge formats -- the same disk Fusion caches on, shared by every task
 * on the instance. Without fast instance storage it is the 100 GB boot volume:
 * too small for SIMULATE_AND_BATCH at genome scale. Both scripts log `df -h .`
 * to .command.err, so check there where scratch landed.
 *
 * stageOutMode 'move' (the default with scratch is copy) frees each output from
 * local disk as it is copied out, rather than holding ~65 GB of batched FASTQ
 * in scratch and Fusion's write cache at once.
 *
 * The withName pattern is its own selector, so it adds these two settings
 * without replacing a profile's SIMULATE_AND_BATCH / SCORE resource blocks.
 */

process {
    withName: 'SIMULATE_AND_BATCH|SCORE' {
        scratch      = true
        stageOutMode = 'move'
    }
}
