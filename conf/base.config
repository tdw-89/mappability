/*
 * Resource requests by process; executor and queue come from the environment
 * profile. Any genome works, but the serial steps scale with the number of
 * simulated pairs, and these were sized on the zebrafish run (28,407
 * protein-coding genes, 12,256 regions, L = 60,150, 13 fragment lengths,
 * step 10, plus orientation: ~2.8 billion pairs). ALIGN_BATCH does not grow:
 * the batch count does, per --pairs_per_batch. See README "Scale".
 *
 *   SAMTOOLS_FAIDX      only when no .fai sits beside --fasta.
 *   BUILD_LOCI          bin/select_genes.sh over the GFF + `unimap loci`.
 *                       Measured on GRCz12tu: ~1 min and 60 MB for the
 *                       selection, then 14 s and 1.3 GB peak RSS.
 *   SIMULATE_AND_BATCH  `unimap simulate` threads over regions, so it takes
 *                       every core it is given. Peak disk ~70 GB: the per-region
 *                       FASTQs, consumed batch by batch as they are packed.
 *   ALIGN_BATCH         bowtie2 is the whole cost of the run (~1,000 vCPU-h
 *                       for zebrafish); --pairs_per_batch keeps each task ~1 h.
 *                       The index needs ~2.5 GB per Gb of genome (~3.5 GB for
 *                       zebrafish); the rest is thread buffers.
 *   SCORE               `unimap score` scans the shards in parallel and builds
 *                       per-region tracks in parallel; the Zarr writes are
 *                       serial but Blosc-threaded. Projected ~30 min at genome
 *                       scale on 8 cores, most of it the Zarr store (~600 GB of
 *                       counts per read length before compression). Memory is
 *                       the per-fragment status/MAPQ tables for every L at once
 *                       (~6 GB) plus the reference regions and track buffers.
 *
 * Memory doubles on retry. Retune against peak_rss in
 * <outdir>/pipeline_info/trace.txt.
 */

process {
    // pipefail: every alignment and concatenation here is a pipe or a cat, and
    // a failure upstream of one must not leave a short file that looks fine.
    shell = ['/bin/bash', '-euo', 'pipefail']

    cpus   = 1
    memory = { 2.GB * task.attempt }
    time   = { 1.h  * task.attempt }

    // 137/139 = OOM-kill / segfault, 143 = SIGTERM (Slurm walltime, Spot
    // reclaim), 104/134 = transfer and abort failures seen on Batch. A null or
    // MAX_VALUE status is a task killed without one -- a reclaimed Spot
    // instance. Anything else is a real error and stops the run: scoring needs
    // every shard, so there is nothing useful to carry on with.
    errorStrategy = { (task.exitStatus == null || task.exitStatus == Integer.MAX_VALUE ||
                       task.exitStatus in [104, 134, 137, 139, 143, 247]) &&
                      task.attempt <= params.max_retries ? 'retry' : 'terminate' }
    maxRetries    = params.max_retries

    withName: SAMTOOLS_FAIDX {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }

    withName: BOWTIE2_BUILD {
        cpus   = 8
        memory = { 16.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    withName: BUILD_LOCI {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }

    withName: SIMULATE_AND_BATCH {
        cpus   = 32
        memory = { 32.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    withName: ALIGN_BATCH {
        cpus   = 16
        memory = { 16.GB * task.attempt }
        time   = { 3.h   * task.attempt }
    }

    withName: SCORE {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
}
