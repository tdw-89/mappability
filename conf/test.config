/*
 * The bundled mini-genome; combine with an environment:
 *
 *   nextflow run . -profile test,local --unimap_project ../UniMap.jl
 *   nextflow run . -profile test,docker
 *
 * The fixture (test/data, rebuilt by test/make_fixture.py) is ~120 kb with a
 * planted paralog, an N block, merging loci and decoy non-coding genes; see that
 * script for the layout. There is no committed bowtie2 index, so this also runs
 * BOWTIE2_BUILD -- and, with no .fai beside the FASTA, SAMTOOLS_FAIDX.
 *
 * The grid is scaled to the fixture, not to real data: short reads and
 * fragments keep it to ~20k pairs per read length, and 3 batches over 6
 * regions makes the batch planner actually pack.
 */

params {
    fasta            = "${projectDir}/test/data/genome.fa"
    gff              = "${projectDir}/test/data/annotation.gff3"
    bowtie2_index    = null

    // 500 bp flanks merge gene-uniqB and gene-nearC into one region (their
    // flanks meet), and clip gene-edgeD's upstream flank at the chromosome start.
    upstream         = 500
    downstream       = 500

    read_lengths     = '30,50'
    fragment_lengths = '50,80,120,160,200'
    step             = 5
    orientation      = 'plus'
    // 19,688 pairs per L -> 3 batches, by the same rule a real run uses.
    pairs_per_batch  = 8000

    outdir           = 'results_test'
    max_retries      = 0
}

process {
    withName: SAMTOOLS_FAIDX     { cpus = 1; memory = 1.GB; time = 10.m }
    withName: BOWTIE2_BUILD      { cpus = 2; memory = 1.GB; time = 10.m }
    withName: BUILD_LOCI         { cpus = 1; memory = 2.GB; time = 15.m }
    withName: SIMULATE_AND_BATCH { cpus = 2; memory = 2.GB; time = 30.m }
    withName: ALIGN_BATCH        { cpus = 2; memory = 1.GB; time = 15.m }
    withName: SCORE              { cpus = 2; memory = 3.GB; time = 30.m }
}
