/*
 * UMass Unity: Slurm + Apptainer.
 *
 *   nextflow run . -profile unity --fasta ... --gff ... --bowtie2_index ... \
 *       -w /scratch/workspace/<user>-mappability/work --outdir results
 *
 * The caller supplies the Apptainer directories -- nothing is set here, since a
 * config value overrides the environment:
 *   export APPTAINER_TMPDIR=/work/<pi>/<user>/apptainer_temp
 *   export APPTAINER_CACHEDIR=/work/<pi>/<user>/apptainer_cache
 *   export NXF_APPTAINER_CACHEDIR=/work/<pi>/<user>/nxf_apptainer_cache
 *
 * Put the work directory on scratch: at genome scale it holds ~65 GB of batched
 * FASTQ and ~110 GB of shard BAMs, plus the ~7 GB Zarr store SCORE writes.
 * Clean it once the run is published.
 *
 * Run the controller in a batch job or tmux on a login node; it is a light
 * process that waits ~4 hours for 80 alignment jobs.
 *
 * cpus, memory and time are restated in every withName block on purpose: a
 * block in a profile replaces the same selector in conf/base.config rather than
 * merging with it. Check any change with
 *   nextflow config . -profile unity | sed -n '/ALIGN_BATCH/,/}/p'
 */

params {
    cpu_partition = 'cpu'
}

apptainer {
    enabled    = true
    autoMounts = true
}

executor {
    name            = 'slurm'
    queueSize       = 100
    submitRateLimit = '10/1min'
}

process {
    executor = 'slurm'
    queue    = { params.cpu_partition }

    withName: SAMTOOLS_FAIDX {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }

    withName: BOWTIE2_BUILD {
        cpus   = 16
        memory = { 32.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    withName: BUILD_LOCI {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }

    withName: SIMULATE_AND_BATCH {
        cpus   = 32
        memory = { 32.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    withName: ALIGN_BATCH {
        cpus   = 16
        memory = { 16.GB * task.attempt }
        time   = { 3.h   * task.attempt }
    }

    withName: SCORE {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
}
