/*
 * A workstation or laptop, no containers: julia, bowtie2 and samtools come from
 * PATH, and UniMap from a local checkout.
 *
 *   nextflow run . -profile local --unimap_project ~/path/to/UniMap.jl \
 *       --fasta ref.fna --gff ref.gff --bowtie2_index ref/bowtie2/ref
 *
 * --unimap_project falls back to $UNIMAP_PROJECT. The checkout needs an
 * instantiated environment (julia --project=<dir> -e 'using Pkg; Pkg.instantiate()').
 * Results are only reproducible against the cloud/HPC runs if bowtie2 is the
 * same version; score.toml records which one ran.
 *
 * A laptop is for a handful of genes or the test fixture. The full zebrafish
 * grid is ~1,000 vCPU-hours of bowtie2: run that on unity or aws.
 *
 * Sized for an 8-core / 16 GB Mac. Each ALIGN_BATCH loads its own copy of the
 * bowtie2 index (~3.5 GB for a 1.4 Gb genome), so two fit at a time.
 */

params {
    unimap_project = System.getenv('UNIMAP_PROJECT')
}

executor {
    name   = 'local'
    cpus   = 8
    memory = '12 GB'
}

process {
    executor = 'local'

    // Retrying on a laptop rarely helps and costs a second pass.
    errorStrategy = 'terminate'
    maxRetries    = 0

    withName: SAMTOOLS_FAIDX     { cpus = 1; memory = 1.GB; time = 1.h  }
    withName: BOWTIE2_BUILD      { cpus = 4; memory = 8.GB; time = 24.h }
    withName: BUILD_LOCI         { cpus = 2; memory = 3.GB; time = 1.h  }
    withName: SIMULATE_AND_BATCH { cpus = 8; memory = 8.GB; time = 24.h }
    withName: ALIGN_BATCH        { cpus = 4; memory = 6.GB; time = 24.h }
    withName: SCORE              { cpus = 4; memory = 8.GB; time = 24.h }
}
