/*
 * AWS Batch + Docker, launched directly with Nextflow (not through Seqera --
 * for that use the `seqera` profile, which sets no executor or queue).
 *
 *   nextflow run . -profile aws --aws_queue <queue> -w s3://<bucket>/work \
 *       --fasta s3://... --gff s3://... --bowtie2_index s3://.../GRCz12tu \
 *       --outdir s3://<bucket>/mappability
 *
 * Every input may be an s3:// URI; they are resolved with file(), never joined
 * onto the launch directory. The compute environment's AMI needs the AWS CLI
 * (pass --aws_cli_path if it is not on the default path).
 *
 * Disk, without Fusion: each task downloads its inputs before it starts and
 * uploads its outputs after, so the instance's volume must hold both at once.
 * Size the compute environment's EBS (or use EBS autoscaling) for the worst:
 *   SIMULATE_AND_BATCH  ~70 GB  (FASTQs are packed and deleted as they go)
 *   ALIGN_BATCH         ~5 GB   (index 2.1 GB + one batch + its shard)
 *   CAT_AND_SCORE       ~180 GB (all shards ~110 GB staged in, the per-L
 *                                BAMs written while shards are deleted, then
 *                                the Zarr store and its tar)
 * Nextflow's `disk` directive is not applied to Batch EC2 jobs, so it is not
 * set here; the volume is a property of the compute environment.
 *
 * Memory is sized to ECS-available RAM, ~4-6% under nominal: a round 16 GB
 * does not fit a 16 GiB m5.xlarge and silently escalates to the next size.
 */

params {
    aws_region   = 'us-east-1'
    aws_queue    = null
    aws_cli_path = null
}

docker {
    enabled = true
}

aws {
    region = params.aws_region
    batch {
        cliPath              = params.aws_cli_path
        maxParallelTransfers = 8
        maxTransferAttempts  = 3
        delayBetweenAttempts = '30 sec'
    }
}

executor {
    name      = 'awsbatch'
    queueSize = 100
}

process {
    executor = 'awsbatch'
    queue    = { params.aws_queue }

    withName: SAMTOOLS_FAIDX {
        cpus   = 1
        memory = { 1.5.GB * task.attempt }
        time   = { 1.h    * task.attempt }
    }

    withName: BOWTIE2_BUILD {
        cpus   = 16
        memory = { 28.GB * task.attempt }       // c5.4xlarge
        time   = { 8.h   * task.attempt }
    }

    withName: BUILD_LOCI {
        cpus   = 2
        memory = { 3.5.GB * task.attempt }      // c5.large
        time   = { 1.h    * task.attempt }
    }

    withName: SIMULATE_AND_BATCH {
        cpus   = 32
        memory = { 60.GB * task.attempt }       // c5.9xlarge / c6i.8xlarge
        time   = { 4.h   * task.attempt }
    }

    // The 80-task fan-out; this is where Spot pays for itself, and the
    // errorStrategy in conf/base.config retries a reclaimed task.
    withName: ALIGN_BATCH {
        cpus   = 16
        memory = { 28.GB * task.attempt }       // c5.4xlarge
        time   = { 3.h   * task.attempt }
    }

    withName: CAT_AND_SCORE {
        cpus   = 4
        memory = { 15.GB * task.attempt }       // m5.xlarge; r5.xlarge on retry
        time   = { 8.h   * task.attempt }
    }
}
